# Copy to .env. Everything works offline with the defaults below (mock mode).
DATA_DIR=data
LOG_JSON=true

# Enrichment: mock (local fixture) | http (any JSON API that accepts ?domain=)
ENRICHMENT_MODE=mock
ENRICHMENT_URL=
ENRICHMENT_API_KEY=

# AI scoring: leave OPENAI_API_KEY empty to use the deterministic heuristic scorer.
# Works with OpenAI, Azure OpenAI, OpenRouter, Groq, Ollama (http://localhost:11434/v1)...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
HOT_LEAD_THRESHOLD=70

# Destination: sqlite | csv | google_sheets | hubspot
SINK=sqlite
GOOGLE_SHEETS_WEBHOOK_URL=
HUBSPOT_TOKEN=

# Alerts: console (writes data/alerts.log) | slack | email
NOTIFIER=console
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Reliability
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY=0.5
# Optional shared secret the form/n8n must send as X-Webhook-Secret
WEBHOOK_SECRET=
